@article{brusteinAntiSemitismEuropeHolocaust2004,
	title = {Anti-{Semitism} in {Europe} before the {Holocaust}},
	volume = {25},
	issn = {01925121},
	abstract = {It is commonly accepted that the years 1899-1939 represent a highpoint in anti-Semitism in western societies. What factors account for the wave of extraordinary anti-Semitism after 1899? Was the rise of anti-Semitism between 1899 and the Holocaust uneven? Did anti-Semitism vary in content and intensity across societies? Did Germans embrace anti-Semitism differently from French, Italian, Romanian, and British citizens? Data drawn from the annual volumes of the American Jewish Year Book are used to examine these questions systematically. Pooled time-series analyses suggest that variation in anti-Semitism over time and across countries was largely a function of economic conditions and Jewish immigration, and to a limited extent of the rise of leftist parties. /// Il est g\&\#xe9;n\&\#xe9;ralement admis que les ann\&\#xe9;es qui s'\&\#xe9;tendent de 1899 \&\#xe0; 1939 marquent l'apog\&\#xe9;e de l'antis\&\#xe9;mitisme dans les soci\&\#xe9;t\&\#xe9;s occidentales. Quels sont les facteurs qui expliquent l'extraordinaire vague d'antis\&\#xe9;mitisme qui d\&\#xe9;ferla \&\#xe0; partir de 1899? L'antis\&\#xe9;mitisme varie-t-il en contenu et en intensit\&\#xe9; \&\#xe0; travers le temps et selon les types de soci\&\#xe9;t\&\#xe9;? L'auteur utilise des \&\#xe9;l\&\#xe9;ments tir\&\#xe9;s des publications annuelles de l'American Jewish Year Books pour se livrer \&\#xe0; un examen syst\&\#xe9;matique de ces questions. Des analyses de s\&\#xe9;quences \&\#xe9;tal\&\#xe9;es dans le temps sugg\&\#xe8;rent que les variations de l'antis\&\#xe9;mitisme les \&\#xe9;poques et \&\#xe0; travers les pays d\&\#xe9;pendent largement des conditions \&\#xe9;conomiques, de l'immigration des Juifs, et dans une certaine mesure de la mont\&\#xe9;e des partis de gauche.},
	number = {1},
	journal = {International Political Science Review / Revue internationale de science politique},
	author = {Brustein, William I. and King, Ryan D.},
	year = {2004},
	pages = {35--53}
}

