@article{ebertPremierDreyfusardJewishness1993,
	title = {'{Le} {Premier} {Dreyfusard}': {Jewishness} in {Marcel} {Proust}},
	volume = {67},
	issn = {0016111X},
	abstract = {The Dreyfus Affair was pivotal in Proust's life and art. It is the sole political event that has any significance in the entire novel. The antisemitism that surfaced with it alerted Proust to the Jewish heritage from his mother, thereby sharpening his sensitiveness to the intimations and subtleties of social discourse, and honing his skills in recounting them. Proust accomplishes his documented intent to have Jews as one of the thematic constants in his work by inserting Jewish characters (particularly the dominant one, Swann) and by using the Dreyfus Affair and antisemitism as literary tools for peering into high society. His essential Jewishness as a person is unresolved and adherence to any religious faith is questionable. The Dreyfus Affair and his Jewish heritage, however, were indispensable to his genius.},
	number = {2},
	journal = {The French Review},
	author = {Ebert, Isabelle Monette},
	year = {1993},
	pages = {196--217}
}

